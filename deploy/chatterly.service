# /etc/systemd/system/chatterly.service
[Unit]
Description=Chatterly-Renewed
After=network.target

[Service]
User=ubuntu
# Secrets (JWT_SECRET, SERVER_SECRET, TURN_*) live in a file only root can read (chmod 600), never in this unit.
EnvironmentFile=-/etc/chatterly.env
WorkingDirectory=/home/ubuntu/ChatterlyRenewed
Environment=NODE_ENV=production
Environment=TRUST_PROXY=1
Environment=DATA_DIR=/home/ubuntu/chatterly-data
Environment=CORS_ORIGINS=https://chatterly.example.com
ExecStart=/usr/bin/node scripts/produccion.mjs
Restart=always
RestartSec=3
# Hardening: the app only writes in its data folder and has no extra privileges.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/chatterly-data
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
