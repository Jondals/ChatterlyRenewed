# Caddyfile used by docker-compose.yml. The domain comes from the DOMAIN variable of the .env file.
{$DOMAIN} {
	encode zstd gzip

	# The browser is told to use HTTPS only, not to guess types and not to send where it came from.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# The API and the WebSocket go to the backend, everything else is the web app.
	@backend path /api/* /ws
	reverse_proxy @backend app:3000
	reverse_proxy app:4200
}
